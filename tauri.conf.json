{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kosp Injection",
  "identifier": "com.gasleboss.twitninfupdater",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kosp Injection",
        "width": 460,
        "height": 700,
        "minWidth": 360,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "publisher": "gasleboss",
    "copyright": "Kosp Injection"
  }
}
